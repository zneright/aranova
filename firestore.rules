rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has a specific role
    function hasRole(role) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId
          ? !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          : hasRole('admin') || hasRole('cooperative')
      );
      allow delete: if hasRole('admin');
    }

    // Vaults
    match /vaults/{vaultId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || hasRole('admin')
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid || hasRole('admin')
      );
      allow delete: if hasRole('admin');
    }

    // Fuel requests (Loans and Fuel Credits)
    match /fuel_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.driverId == request.auth.uid || 
        resource.data.coopId == request.auth.uid || 
        hasRole('admin')
      );
      allow create: if isAuthenticated() && (
        request.resource.data.driverId == request.auth.uid || hasRole('admin')
      );
      allow update: if isAuthenticated() && (
        // Allow driver to self-sign approved loans
        (
          resource.data.driverId == request.auth.uid &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'signed_by_borrower' &&
          request.resource.data.amount == resource.data.amount &&
          request.resource.data.driverId == resource.data.driverId &&
          request.resource.data.coopId == resource.data.coopId
        ) ||
        // Allow cooperative admin to update pool loans
        (
          resource.data.coopId == request.auth.uid &&
          hasRole('cooperative')
        ) ||
        // Allow system admins
        hasRole('admin')
      );
      allow delete: if hasRole('admin');
    }

    // Transactions
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (
        resource.data.from == request.auth.uid || 
        resource.data.to == request.auth.uid || 
        hasRole('admin')
      );
      allow create: if isAuthenticated() && request.resource.data.from == request.auth.uid;
      allow update, delete: if hasRole('admin');
    }

    // System configurations & App Configs
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }

    // App configurations
    match /app_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin') || hasRole('cooperative');
    }

    // Cooperatives Stats
    match /coop_stats/{coopId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == coopId || hasRole('admin') || hasRole('cooperative')
      );
    }

    // Audit logs
    match /admin_audit_logs/{logId} {
      allow read: if hasRole('admin');
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Announcements
    match /announcements/{annId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('admin') || hasRole('cooperative');
      allow update, delete: if hasRole('admin');
    }

    // Announcement Reads
    match /announcement_reads/{readId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if hasRole('admin');
    }
  }
}